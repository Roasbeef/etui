{application, etui, [
    {vsn, "2.0.0"},
    {applications, [gleam_javascript,
                    gleam_stdlib]},
    {description, "A TUI library for Gleam: correct Unicode, minimal-diff rendering, clean terminal teardown."},
    {modules, [etui,
               etui@anim,
               etui@app,
               etui@backend,
               etui@backend@browser,
               etui@backend@default,
               etui@backend@erlang,
               etui@backend@node,
               etui@braille,
               etui@buffer,
               etui@color,
               etui@cursor,
               etui@focus,
               etui@geometry,
               etui@input,
               etui@keymap,
               etui@keys,
               etui@span,
               etui@style,
               etui@terminal,
               etui@text,
               etui@theme,
               etui@undo,
               etui@widget,
               etui@widgets@block,
               etui@widgets@canvas,
               etui@widgets@chart,
               etui@widgets@clear,
               etui@widgets@dialog,
               etui@widgets@fieldset,
               etui@widgets@form,
               etui@widgets@gauge,
               etui@widgets@gradient_bar,
               etui@widgets@hbar,
               etui@widgets@help,
               etui@widgets@input,
               etui@widgets@line,
               etui@widgets@line_gauge,
               etui@widgets@list,
               etui@widgets@marquee,
               etui@widgets@multi_select,
               etui@widgets@notification,
               etui@widgets@paginator,
               etui@widgets@paragraph,
               etui@widgets@popup,
               etui@widgets@progress,
               etui@widgets@scene,
               etui@widgets@scroll_view,
               etui@widgets@scrollbar,
               etui@widgets@sparkline,
               etui@widgets@spinner,
               etui@widgets@statusbar,
               etui@widgets@table,
               etui@widgets@tabs,
               etui@widgets@textarea,
               etui@widgets@tree,
               etui_buffer_array_ffi,
               etui_run_ffi,
               etui_terminal_ffi,
               etui_tty_state]},
    {registered, []}
]}.
